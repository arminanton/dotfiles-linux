remove_containers() {
    containers=$(sudo ctr containers ls | awk 'NR>1 {print $1}')
    for container in $containers; do
        sudo ctr container rm $container
    done
}

remove_images() {
    images=$(sudo ctr images ls | awk 'NR>1 {print $1}')
    for image in $images; do
        sudo ctr image rm $image
    done
}

remove_snapshots() {
    snapshots=$(sudo ctr snapshots ls | awk 'NR>1 {print $1}')
    for snapshot in $snapshots; do
        sudo ctr snapshot rm $snapshot
    done
}

remove_content() {
    content=$(sudo ctr content ls | awk 'NR>1 {print $1}')
    for item in $content; do
        sudo ctr content rm $item
    done
}

function docker-clean()
{
    set -x

    sudo docker system prune -a --volumes -f

    # Remove containers, images, snapshots, and content with retries
    for i in {1..10}; do
        remove_containers
        remove_images
        remove_snapshots
        remove_content
    done

    # Forcefully prune snapshots (if any remaining)
    sudo ctr snapshots prune

    # Remove dangling Docker volumes
    sudo sh -c 'docker volume ls -qf dangling=true | xargs -r docker volume rm'
    sudo docker system df

    sudo yum clean all
    sudo journalctl --vacuum-time=7d

    sudo df -h
    sudo du -sh /var/* | sort -h
    sudo du -sh /var/lib/* | sort -h
    sudo du -sh /var/lib/containerd/* | sort -h
    sudo du -h --max-depth=1 /var/lib/containerd
    sudo du -sh /var/log/* | sort -h

    sudo systemctl status docker
    sudo systemctl status containerd

    docker --version
    docker info
}

function docker-recursive() # build image by layers
{
    local repo="${1:-scratch}"
    local file="${repo}.Dockerfile"
    local stage_last="${2}"
    local params="${3}"

    set -o pipefail

    local stop=""

    # Declare an array to store file lines manually
    declare -a lines
    while IFS= read -r line; do
        lines+=("$line")  # Append each line to the array
    done < "$file"

    # Iterate over the manually built array
    for line in "${lines[@]}"; do
        # Check if the line contains a FROM statement with AS
        if [[ "$line" =~ ^FROM[[:space:]].*[[:space:]]AS[[:space:]] ]]; then
            # Extract the stage name after AS
            stage_name=$(echo "$line" | awk '{for(i=1;i<=NF;i++) if($i=="AS") print $(i+1)}')

            if [[ -z "${stop}" ]]; then
                echo "

[next] repo: [${repo}] | stage: [${stage_name}] | stop_after: [${stage_last}]"

                # Ensure user input works interactively
                echo -e "Press Enter to continue..."
                read </dev/tty

                if [[ "${stage_name}" == "${stage_last}" ]] && [[ -n "${3}" ]]; then
                    echo "params: [${params}]"
                    docker-build "${repo}" "${stage_name}" "${params}"
                else
                    docker-build "${repo}" "${stage_name}"
                fi
            fi

            if [[ "${stage_name}" == "${stage_last}" ]]; then
                stop="stop-next"
            fi
        fi
    done
    echo "[completed]"
}

function docker-build() # builds using docker
{
    local repo="${1:-scratch}"
    local file="docker/images/${repo}/Dockerfile"
    # local file="${repo}.Dockerfile"
    local version="${2:-dev}"
    local params=($3)
    local target=()

    if [[ "${version}" != "dev" ]]; then
        target=(--target "${version}")
    fi

    set -x
    docker build --progress=plain --network=host "${target[@]}" "${params[@]}" -t "${repo}:${version}" -f "${file}" ./docker/images/${repo}/.

    # Ensure build completion before returning
    wait
}

function docker-run() # builds using docker
{
    local repo="${1:-scratch}"
    local version="${2:-dev}"
    local user="${3:-root}"
    set -x

    docker run -it --rm --network=host --entrypoint "/bin/bash" --user "${user}" "${repo}:${version}"
}

function podman-build() # build image
{
    local app="${1:-ndsessionms}"
    local image="${2}"
    if [[ "${image}" == "nginx" ]]; then
        podman build --no-cache -t ${app}-nginx:test-version-1 configs/nginx/.
        podman run --name nginx -p 8443:8443 -d ${app}-nginx:test-version-1
    fi
    if [[ "${image}" == "fpm" ]]; then
        podman build --no-cache -t ${app}:test-version-1 -f Dockerfile .
        podman run --name fpm -p 9091:9091 -d ${app}:test-version-1
