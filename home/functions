function run-with-title() # runs any command with a title in it
{
    # Command to execute
    local command=("${@:2}")

    # Save current screen and cursor settings
    tput smcup
    tput civis

    # Setup a trap to restore screen settings on exit and clear the screen
    trap 'cleanup_and_exit' INT TERM EXIT

    # Function to restore terminal state and exit cleanly
    cleanup_and_exit() {
        tput rmcup  # Restore the screen
        tput cnorm  # Show cursor
        clear       # Clear the terminal screen
        stty echo   # Ensure echo is enabled
        echo "Exited cleanly"
        # Kill the background job without affecting the parent shell
        [[ -n "$background_pid" ]] && cmd_exec="$(kill $background_pid 2>&1 >/dev/null)"
        # Reset trap to default and exit script without exiting the parent shell
        trap - INT TERM EXIT
        return 0  # Return instead of exit to avoid closing the shell
    }

    # Print the title
    echo -e "\e[1;33m$1\e[0m"

    # Create a buffer to hold the last 60 lines of output
    local buffer=()
    local buffer_size=60
    local line_count=0

    # Execute the command, capture both stdout and stderr, and run it in the background
    "${command[@]}" 2>&1 | while IFS= read -r line; do
        buffer+=("$line")
        ((line_count++))

        # Clear the screen below the title and reprint the buffer
        tput cup 1 0
        tput ed  # Clear everything below the current line

        if ((line_count > buffer_size)); then
            # Only keep the last buffer_size lines
            buffer=("${buffer[@]: -buffer_size}")
        fi

        for buffer_line in "${buffer[@]}"; do
            echo "$buffer_line"
        done

        # Move back to the first line and print the title again
        tput cup 0 0
        echo -e "\e[1;33m$1\e[0m"
    done &

    # Save the background process PID
    background_pid=$!
    wait "$background_pid"  # Wait for the background job to finish

    cleanup_and_exit  # Ensure cleanup if the command finishes normally
}


