function ecs-container-status() # check if a container is running within a task in AWS ECS
{
    local cluster_name=$1
    local task_id=$2
    local container_name=$3

    if [[ -n "$cluster_name" && -n "$task_id" && -n $container_name ]]; then
        while true; do
            # Check the status of the container
            # echo "[${cluster_name}] [${container_name}] [${task_id}]"
            local container_status="$(aws ecs describe-tasks --cluster "$cluster_name" --tasks "$task_id" --query "tasks[0].containers[?name=='$container_name'].lastStatus" --output text --profile ${AWS_PROFILE} --region us-east-1 2>&1 || true)"

            # If the container is not running, kill the execute-command process and exit the script
            if [[ "$container_status" != "RUNNING" ]]; then
                echo "Container is not running. Stopping the execute-command process."
                pkill -P $$ # Kill all child processes of this script
                exit 1
            fi
            sleep 10
        done
    else
        echo "ECS SSH Variables are not defined or empty"
        pkill -P $$ # Kill all child processes of this script
    fi
}

function ecs-ssh() # connect to a container within a task in AWS ECS
{
    echo "Please enter the task name/id: "
    read task_id

    # Set your ECS parameters
    local cluster_name="${1}-infra"
    local container_name="${2:-$1}"
    local command="/bin/bash"

    # Run the ecs-container-status function in the background
    ecs-container-status "$cluster_name" "$task_id" "$container_name" &

    # Start the AWS ECS execute-command in the foreground for interactive shell access
    aws ecs execute-command --cluster "$cluster_name" --task "$task_id" --container "$container_name" --command "$command" --interactive --profile ${AWS_PROFILE} --region us-east-1

    # Cleanup: Kill the ecs-container-status background process
    pkill -P $$ # Kill all child processes of this script
}

