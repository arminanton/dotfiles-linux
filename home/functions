function clean-space() # delete common cache
{
    local paths=(
        /home/ndsadmin/.local/share/containers
        /home/ndsadmin/.config/containers
        # /storage/overlay
        # /home/ndsadmin/.local/share/containers/storage
        /var/log
        /var/lib/containers
        # /storage/overlay
        /var/tmp
        /mnt/geoip
        /mnt/tmp/scratchspace
        /tmp
    )

    for item in "${paths[@]}"; do
        if [ -d "$item" ]; then
            sudo find "$item" -mindepth 1 -exec rm -rf {} + 2>/dev/null || true
        fi
    done

    podman-prune
}

function podman-prune() # prune everything related to podman
{
    local steps=(
        "pod rm -f -a"
        "container prune -f"
        "volume prune -f"
        "image prune -a -f"
        "system prune -a --volumes -f"
        "rmi -f \$(podman images -q)"
        "system reset -f"
    )

    for cmd in "${steps[@]}"; do
        {
            sudo podman ${cmd} || true
            podman ${cmd} || true
        } >/dev/null 2>&1
    done

    # De-register all existing QEMU binfmt_misc entries
    echo "De-registering existing QEMU binfmt_misc entries..."

    setopt +o nomatch   # Temporarily disable nomatch error
    for entry in /proc/sys/fs/binfmt_misc/qemu-*; do
        if [[ -f "$entry" ]]; then
            {
                echo -1 | sudo tee "$entry" >/dev/null 2>&1
            } >/dev/null 2>&1
            echo "Removed: $entry"
        fi
    done
    setopt nomatch      # Re-enable

    # Now run the container
    echo "Running QEMU registration container..."
    sudo -i podman run --rm --network=host --privileged \
        registry.artifactory.intra.nudatasecurity.com/multiarch/qemu-user-static \
        --reset --credential yes --persistent yes
}

function gitconfig_to_json() # pass changes from one to another
{
  local infile="${1:-$HOME/.gitconfig}"
  local outfile="${2:-$HOME/.repo_.gitconfig.json}"

  awk '
  function escape(str) {
    gsub(/\\/, "\\\\", str)
    gsub(/"/, "\\\"", str)
    return str
  }

  BEGIN {
    print "{"
  }

  /^\s*\[.*\]\s*$/ {
    match($0, /^\s*\[([a-zA-Z0-9._-]+)(\s+"([^"]+)")?\]/, m)
    section = m[1]
    subsection = m[3]
    next
  }

  /^[[:space:]]*[a-zA-Z0-9._-]+[[:space:]]*=/ {
    split($0, kv, "=")
    key = kv[1]
    value = substr($0, index($0, "=") + 1)
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)

    full_key = section
    if (subsection != "")
      full_key = full_key "." subsection
    full_key = full_key "." key

    escaped_key = escape(full_key)
    escaped_val = escape(value)

    if (seen[escaped_key]++) {
      vals[escaped_key] = vals[escaped_key] ", \"" escaped_val "\""
    } else {
      keys[++n] = escaped_key
      vals[escaped_key] = "\"" escaped_val "\""
    }
  }

  END {
    for (i = 1; i <= n; ++i) {
      k = keys[i]
      printf "  \"%s\": [%s]", k, vals[k]
      if (i < n) print ","
      else print ""
    }
    print "}"
  }
  ' "$infile" > "$outfile"

  echo "Converted $infile → $outfile"
}

function git-owner() # set owner name and email
{
    local name="${GIT_USERNAME}"
    local email="${GIT_USEREMAIL}"

    if [[ -n "${string}" ]]; then
        echo "string is not empty"
    fi


    if [[ -n "${1}" ]]; then
        name="${1}"
        echo "export GIT_USERNAME=\"${name}\"" | sudo tee /etc/profile.d/user.sh > /dev/null
    fi

    if [[ -n "${2}" ]]; then
        email="${2}"
        echo "export GIT_USEREMAIL=\"${email}\""| sudo tee -a /etc/profile.d/user.sh > /dev/null
        source /etc/profile.d/user.sh
    fi

    if [[ -n "${name}" ]] && [[ -n "${email}" ]]; then
        git config --global user.name "${name}"
        git config --global user.email "${email}"
        gitconfig_to_json
    fi
}

