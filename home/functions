switch-java() # change java version
{
  local version="$1"
  local apps=(java javac jar)

  case "$version" in
    8)   version="1.8.0" ;;
    11)  ;;
    17)  ;;
    21)  ;;
    23)  version="latest" ;;
    25)  version="latest" ;;
    26)  version="latest" ;;
    *) echo "Usage: switch-java {8|11|17|21|23|25|26}"; return 1 ;;
  esac

  local base_path="/usr/lib/jvm/java-${version}-openjdk"

  for app in "${apps[@]}"; do
    local cmds=$(sudo alternatives --set ${app} ${base_path}/bin/${app} 2>&1)
    sudo rm -rf /etc/alternatives/${app} /usr/bin/${app}
    sudo ln -s ${base_path}/bin/${app} /etc/alternatives/${app}
    sudo ln -s /etc/alternatives/${app} /usr/bin/${app}
  done

  export JAVA_HOME="$base_path"
  export PATH="${JAVA_HOME}/bin:${PATH}"
  export CLASSPATH=".:${JAVA_HOME}/lib:${JAVA_HOME}/lib/tools.jar"
  echo "Switched to Java $ver → JAVA_HOME=$JAVA_HOME"
  java -version
}

