function nix-helper() # Nix command-line helper
{
# nixOPEN
    if [[ -n "${1}" ]]; then
        case $1 in
        list | -l | l) # ************************************ List installed packages
            echo "$(nix-env -q 2>&1)"
            ;;

        update | upgrade | -u | u) # ************************ Update all packages or a specific one
            if [[ -n "${2}" ]]; then
                nix-env -u $2;
            else
                nix-env -u;
            fi
            ;;

        install | -i | i) # ********************************* Install a new package by its name
            #nix-env -iA nixpkgs.$2
            nix-env -f /home/ndsadmin/.nix-pkgs -iA $2
            ;;

        erase | delete | remove | uninstall | -r | r) # ***** Delete an installed package
            nix-env -e $2
            ;;

        backup | generations | -b | b) # ******************** List all backup generations
            echo "$(nix-env --list-generations)"
            ;;

        restore | recover | goback | undo | -z | z) # ******* Rollback to last backup or to specific one
            if [[ -n "${2}" ]]; then
                nix-env --switch-generation $2;
            else
                nix-env --rollback;
            fi
            ;;

        *)
            nix-menu
            ;;
        esac
    else
        nix-menu
    fi
# nixCLOSE
}

function nix-menu() # Nix help menu
{
            hash_symbol="#"
            echo -e "\nNix Package Manager\n"
            sed -n "/${NIX_OPEN}/,/${NIX_CLOSE}/p" "${DOTFILES_PATH}/home/functions" | grep ".)\ #" |
                    sed "s/${hash_symbol}//" |
                    sed -r 's/([a-z])\)/\1/' |
                    sed 's/^ *//g' |
                    sed 's/\*/ /g' |
                    awk '{print $0,"\n"}'
}


#######################################
# Login to AWS and setup credentials
# Arguments:
#   1: AWS Profile (ex: lpstg, ndsdev)
#   2: AWS Region (ex: us-east-1)
# Returns:
#   Nothing
#######################################
function aws_login() # Initiates the AWS SSO login steps and updates keys for AWS cli
{
    AWS_PROFILE=${1}
    AWS_PROFILE=${AWS_PROFILE:='ndsdev'}
    AWS_REGION=${2}
    AWS_REGION=${AWS_REGION:='us-east-1'}

    aws --profile "${AWS_PROFILE}" sso logout >/dev/null 2>&1

    rm -rf "${HOME}/.aws/sso"

    aws --profile "${AWS_PROFILE}" sso login

    aws_setup_credentials
}

#######################################
# Obtains AWS credentials out of SSO
# Arguments:
#   None
# Returns:
#   Nothing
#######################################
function aws_setup_credentials() # Obtains the proper AWS credentials and access keys and sets it under a defined profile
{
    local role
    local id
    local sso_region
    local sso_token
    local credentials
    local log

    role="$(aws_config_value 'role')"

    id="$(aws_config_value 'id')"

    sso_region="$(aws_config_value 'sso_region')"

    sso_token="$(aws_sso_token)"

    log="$(
        printf "\n%s\n\n%s\n\n%s\n%s\n%s\n%s\n%s\n" \
            "Failure in obtaining the credentials!" \
            "@ aws_config_value()" \
            "Found these:" \
            "id: [${id}]" \
            "role: [${role}]" \
            "sso_token: [${sso_token}]" \
            "sso_region: [${sso_region}]"
    )"

    if [[ -z "${role}" ]] || [[ -z "${id}" ]] ||
       [[ -z "${sso_region}" ]] || [[ -z "${sso_token}" ]]; then
        echo -e "${log}"
        exit 1
    fi

    credentials="$(
        aws sso get-role-credentials \
            --role-name "${role}" \
            --account-id "${id}" \
            --access-token "${sso_token}" \
            --region "${sso_region}" \
            --profile "${AWS_PROFILE}" 2>&1
    )"

    log+="$(
        printf "\n%s\n%s\n" \
            "[aws sso get-role-credentials] returned this:" \
            "${credentials}"
    )"

    if [[ "${credentials}" == *"error"* ]]; then
        echo -e "${log}"
        exit 1
    fi

    local access_key
    local secret_access_key
    local session_token

    access_key="$(
        json_parse_value "${credentials}" "accessKeyId"
    )"

    secret_access_key="$(
        json_parse_value "${credentials}" "secretAccessKey"
    )"

    session_token="$(
        json_parse_value "${credentials}" "sessionToken"
    )"

    log+="$(
            printf "\n%s\n%s\n%s\n%s\n\n%s\n%s\n" \
                "Then, found these:" \
                "access_key: [${access_key}]" \
                "secret_access_key: [${secret_access_key}]" \
                "session_token: [${session_token}]" \
                "[aws configure set] returned this:" \
                "${execute}"
        )"

    if [[ "${execute}" == *"error"* ]]; then
        echo -e "${log}"
        exit 1
    fi

    local execute
    execute="$(
        aws configure set aws_access_key_id "${access_key}" --profile "${AWS_PROFILE}" 2>&1
        aws configure set aws_secret_access_key "${secret_access_key}" --profile "${AWS_PROFILE}" 2>&1
        aws configure set aws_session_token "${session_token}" --profile "${AWS_PROFILE}" 2>&1
        aws configure set region "${AWS_REGION}" --profile "${AWS_PROFILE}" 2>&1
    )"

    export AWS_ACCESS_KEY_ID="${access_key}"
    export AWS_SECRET_ACCESS_KEY="${secret_access_key}"
    export AWS_SESSION_TOKEN="${session_token}"

    echo ""
    aws configure list --profile ${AWS_PROFILE}
}

#######################################
# Extracts values from aws_config
# template file based on key given
# Arguments:
#   1: key
# Returns:
#   Value assigned to that key
#######################################
function aws_config_value() # Retrives the value of said key out from AWS config file in ~/.aws/config
{
    local key
    local value

    if [[ -n "${1}" ]]; then
        key="${1}"

        value="$(
            read_file "${HOME}/.aws/config" |
                sed -n "/${AWS_PROFILE}]/,/role/p" |
                grep "${key}" |
                awk -F' = ' '{ print $2 }' 2>&1
        )"

        echo -e "${value}"
    fi
}

#######################################
# Extracts the SSO Token out of the
# cached login files
# Arguments:
#   None
# Returns:
#   Nothing
#######################################
function aws_sso_token() # Retrieves the AWS SSO token out of the cached logged user files
{
    local cache_files
    local key

    cache_files="$(
        find ~/.aws/sso/cache/*.json | awk '!/botocore/' 2>&1
    )"
    # alternative: awk "${filter}"

    if [[ "${cache_files}" == *"No such file or directory"* ]]; then
        key=""
    else
        IFS=$'\n' # split by new line
        for file in $(find ~/.aws/sso/cache/*.json | awk '!/botocore/' 2>&1); do
            if test $file; then
                IFS=' '  # split by space
                key="$(
                    json_parse_value "$(
                        read_file "${file}"
                    )" "accessToken"
                )"
                #echo $key

                if [[ -n "${key}" ]]; then
                    break
                fi
            fi
            IFS=$'\n' # split by new line
        done
    fi

    echo -e "${key}"
}

#######################################
# Parses a JSON string retriving the
# value of the key provided
# Arguments:
#   1: json
#   2: key
# Returns:
#   Value of the key provided
#######################################
function json_parse_value() # Parse the value of a key from a json string
{
    local json
    local key
    local value

    if [[ -n "${1}" ]] && [[ -n "${2}" ]]; then
        json="${1}"
        key="${2}"

        value="$(
            echo -e "${json}" |
                grep -o "\"${key}\": \"[^\"]*" |
                grep -o '[^"]*$' 2>&1
        )"

        echo -e "${value}"
    fi
}

#######################################
# A safer way to read file contents
# Arguments:
#   Path of the file
# Returns:
#   Prints the file content
#######################################
function read_file() # Reads a file using a safer method than cat and echo
{
    local filepath

    IFS=''

    read -d '' -r filepath <"${1}"
    printf '%s' "${filepath}"

    IFS=' '
}

