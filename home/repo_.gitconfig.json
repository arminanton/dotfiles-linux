{
  "user.email": ["william.anton@mastercard.com"],
  "user.name": ["William Anton"],
  "safe.directory": ["/opt/podman"],
  "credential.https://github.com.helper": ["", "!/usr/bin/gh auth git-credential"],
  "credential.https://gist.github.com.helper": ["", "!/usr/bin/gh auth git-credential"],
  "credential.https://ghe.intra.nudatasecurity.com.helper": ["", "!/usr/bin/gh auth git-credential"],
  "credential.https://git-codecommit.us-east-1.amazonaws.com.helper": ["", "!aws codecommit credential-helper $@"],
  "credential.https://git-codecommit.us-east-1.amazonaws.com.UseHttpPath": ["true"],
  "core.pager": ["diff-so-fancy | less --tabs=4 -RFX"],
  "interactive.diffFilter": ["diff-so-fancy --patch"],
  "color.ui": ["true"],
  "color.diff-highlight.oldNormal": ["red bold"],
  "color.diff-highlight.oldHighlight": ["red bold 52"],
  "color.diff-highlight.newNormal": ["green bold"],
  "color.diff-highlight.newHighlight": ["green bold 22"],
  "color.diff.meta": ["11"],
  "color.diff.frag": ["magenta bold"],
  "color.diff.func": ["146 bold"],
  "color.diff.commit": ["yellow bold"],
  "color.diff.old": ["red bold"],
  "color.diff.new": ["green bold"],
  "color.diff.whitespace": ["red reverse"],
  "diff-so-fancy.stripLeadingSymbols": ["false"],
  "init.defaultBranch": ["master"],
  "push.autoSetupRemote": ["true"],
  "push.default": ["current"],
  "remote.pushDefault": ["origin"],
  "fetch.prune": ["true"]
}
