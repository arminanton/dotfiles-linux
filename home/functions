function git-new-branch() # git checkout -b with branch name validation
{
    if [[ -n "${1}" ]]; then
        if [[ ${1} =~ ^[a-zA-Z0-9._/-]+$ ]]; then
            git checkout -b "${1}"
        else
            echo "Branch name contains invalid characters. Allowed: letters, numbers, dots, underscores, slashes, and dashes."
        fi
    else
        echo "Please provide a branch name."
    fi
}

function git-commit() # Git commit allowing to pass two scripts as message (title and description)
{
    total="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    if [[ -n "${1}" ]]; then
        if [[ ${#1} -le ${#total} ]]; then
            if [[ -n "${2}" ]]; then
                if [[ ${#2} -le ${#total} ]]; then
                    git commit -m "${1}" -m "${2}"
                    export GIT_COMMIT_SAVE="worked"
                else
                    echo "!!! [second string is longer then 72 chars]"
                    export GIT_COMMIT_SAVE="failed"
                fi
            else
                git commit -m "${1}"
                export GIT_COMMIT_SAVE="worked"
            fi
        else
            echo "!!! [first string is longer then 72 chars]"
            export GIT_COMMIT_SAVE="failed"
        fi
    fi
}

function git-commit-amend() # Git commit amend allowing to pass two scripts as message (title and description)
{
    total="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    if [[ -n "${1}" ]]; then
        if [[ ${#1} -le ${#total} ]]; then
            if [[ -n "${2}" ]]; then
                if [[ ${#2} -le ${#total} ]]; then
                    git commit --amend -m "${1}" -m "${2}"
                    export GIT_COMMIT_SAVE="worked"
                else
                    echo "!!! [second string is longer then 72 chars]"
                    export GIT_COMMIT_SAVE="failed"
                fi
            else
                git commit --amend -m "${1}"
                export GIT_COMMIT_SAVE="worked"
            fi
        else
            echo "[first string is longer then 72 chars]"
            export GIT_COMMIT_SAVE="failed"
        fi
    fi
}

function git-push-upstream() # Git push with upstream for new feature branches
{
    local branch_name
    branch_name="$(gb)"
    echo ""
    git push origin $branch_name $@
}

function git-add-commit-push() # git add, status, commit, and push, in sequence
{
    git add .
    git status
    git-commit $@
    if [[ "${GIT_COMMIT_SAVE}" == "worked" ]]; then
        git-push-upstream
    fi
}

function git-add-commit-push-pr-create() # git add, status, commit, push, and create pr in GHE, in sequence
{
    git add .
    git status
    git-commit $@
    if [[ "${GIT_COMMIT_SAVE}" == "worked" ]]; then
        git-push-upstream
        gh-pr-create $1
    fi
}

function gh-pr-create() # gh cli pr create in GHE
{
    local feature_branch
    local target_branch
    feature_branch="$(gb)"
    if [[ -n "$(git ls-remote --heads origin cdk-master)" ]]; then
        target_branch="cdk-master"
    else
        target_branch="$(git remote show origin | grep 'HEAD branch' | cut -d' ' -f5)"
    fi
    template_content=$(curl -H "Authorization: Bearer $(gh auth token --hostname ghe.intra.nudatasecurity.com)" https://raw.ghe.intra.nudatasecurity.com/nds/.github/blob/main/.github/PULL_REQUEST_TEMPLATE.md)
    gh pr create --base $target_branch --head $feature_branch --title $1 --body "$template_content" --assignee @me --fill
}

function git-add-amend-force-push() # git add, amend, and force push, in sequence
{
    git add .
    git status
    git-commit-amend $@
    if [[ "${GIT_COMMIT_SAVE}" == "worked" ]]; then
        git-push-upstream
    fi
}

