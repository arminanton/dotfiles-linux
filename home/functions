}

function podman-remove() # stop container and remove image
{
    local image="${1}"
    podman stop ${image}
    podman rm ${image}
    echo "container stopped and removed!"
}

function podman-reload() # reload the whole process
{
    local app="${1:-ndsessionms}"
    local image="${2}"
    echo -e "\n--> Stopping and removing existing container..."
    podman-remove "${image}"
    echo -e "\n--> Building a new image and starting a new container..."
    podman-build "${app}" "${image}"
    echo -e "\n--> Reload completed! includes: container stop/remove, image re-build, new container start."
    echo -e "\n--> Startup logs:"
    podman-logs "${image}"
    echo -e "\n--> Launching container shell:"
    podman-ssh "${image}"
}

